<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voice_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_voice_overlay_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="28dp"
        android:paddingEnd="40dp"
        android:paddingBottom="24dp">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lav_voice_wave"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_marginTop="4dp"
            app:lottie_autoPlay="true"
            app:lottie_fileName="lottie/loading_1/loading.json"
            app:lottie_loop="true" />

        <TextView
            android:id="@+id/tv_voice_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_voice_partial"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#33FFFFFF"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="36dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_voice_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="上滑取消"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
