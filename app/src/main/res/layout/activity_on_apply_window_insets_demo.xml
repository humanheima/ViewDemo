<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/insets_demo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/share_background"
    tools:context=".activity.OnApplyWindowInsetsDemoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/insets_demo_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/share_primary"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/tv_demo_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WindowInsets 实验室"
                android:textColor="@color/white"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_demo_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="观察 setOnApplyWindowInsetsListener 如何调整真实布局"
                android:textColor="#DDE7FF"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/insets_demo_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="实时分发信息"
                    android:textColor="@color/share_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/insets_demo_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_dispatch_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="当前状态：继续向子 View 分发"
                        android:textColor="@color/share_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_callback_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="回调次数：0"
                        android:textColor="@color/share_text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/share_input_stroke" />

                    <TextView
                        android:id="@+id/tv_status_insets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status bar"
                        android:textColor="@color/share_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_navigation_insets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Navigation bar"
                        android:textColor="@color/share_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_ime_insets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="IME"
                        android:textColor="@color/share_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_cutout_insets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Display cutout"
                        android:textColor="@color/share_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_gesture_insets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="System gestures"
                        android:textColor="@color/share_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="分发控制"
                    android:textColor="@color/share_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/insets_demo_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_consume_insets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="根 View 消费 Insets"
                        android:textColor="@color/share_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_consume_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="根 View 返回原始 Insets，继续向子 View 分发"
                        android:textColor="@color/share_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_request_insets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="重新分发 Insets"
                    android:textAllCaps="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="IME（软键盘）场景"
                    android:textColor="@color/share_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/insets_demo_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <EditText
                        android:id="@+id/et_demo_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/share_input_background"
                        android:hint="输入文字，观察 IME bottom inset"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="11dp"
                        android:textColor="@color/share_text_primary"
                        android:textColorHint="@color/share_text_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_focus_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="唤起键盘"
                            android:textAllCaps="false" />

                        <Button
                            android:id="@+id/btn_hide_keyboard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="收起键盘"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/insets_demo_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/share_surface"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="底部栏会同时避让导航栏和 IME"
                android:textColor="@color/share_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_applied_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Toolbar top padding：0px    底部栏 bottom padding：12px"
                android:textColor="@color/share_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
