<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:padding="16dp"
        android:text="动态创建 NavHostFragment"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="下面的普通容器没有声明 android:name、app:navGraph，NavHostFragment 由 Activity 运行时创建。"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <!-- 普通容器：NavHostFragment 在 Activity 中通过 FragmentTransaction 动态添加。 -->
    <FrameLayout
        android:id="@+id/navigation_dynamic_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white" />
</LinearLayout>
